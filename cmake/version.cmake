# Writes OUT with the engine's `git describe --tags` (CLAUDE.md, Version
# Management: every measurement and every backup names the version it came
# from). Run at every build by the `kds_version` target; the file is
# rewritten only when the text changes, so an unchanged tree recompiles
# nothing.
execute_process(COMMAND git -C ${SRC} describe --tags --always --dirty
                OUTPUT_VARIABLE DESCRIBE OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
if(NOT DESCRIBE)
    set(DESCRIBE "unknown")
endif()
set(TEXT "#pragma once\n// Generated by cmake/version.cmake at build time; never edited.\nnamespace kds {\ninline constexpr const char* kGitDescribe = \"${DESCRIBE}\";\n}  // namespace kds\n")
set(OLD "")
if(EXISTS ${OUT})
    file(READ ${OUT} OLD)
endif()
if(NOT OLD STREQUAL TEXT)
    file(WRITE ${OUT} "${TEXT}")
endif()
