  ddl: CREATE TABLE x4
  load: INSERT x all four relations
  create-index: --index-mode all
  pk-user: WHERE id = ? - index scan on the pk, the control
  loans-by-user: WHERE user_id = ? - ~5 matches
  loans-by-book: WHERE book_id = ? - ~5 matches
  resv-by-user: WHERE user_id = ? on reservations
  books-by-author: WHERE author_id = ? - middle selectivity
  books-by-genre: WHERE genre = ? - 1/16 of the relation
  loans-by-daterange: WHERE loaned_day BETWEEN ? AND ? - 30 days
  overdue: WHERE status = ? AND due_day BETWEEN ? AND ?
  join-loan-user: loans JOIN users ON user_id = id
  join-no-literal: JOIN ON l.user_id = u.id, u.id BETWEEN 1 AND 16 - no literal to propagate
  exists-correlated: EXISTS(loans WHERE user_id = users.id), 20 outer rows
  count-by-user: SELECT COUNT(*) ... WHERE user_id = ?

  index mode all (after load), analyze on
  sizes: users=200, books=200, reservations=500, loans=1000
  no Cabin equivalent exists here - a --cabin ckdbs run has no twin column in the comparison
