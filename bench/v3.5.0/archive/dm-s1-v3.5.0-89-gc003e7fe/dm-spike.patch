diff --git a/include/kds/storage/dm_memo.hpp b/include/kds/storage/dm_memo.hpp
new file mode 100644
index 00000000..1b717b35
--- /dev/null
+++ b/include/kds/storage/dm_memo.hpp
@@ -0,0 +1,65 @@
+#pragma once
+// DM-S1 spike only (never landed): U1, a core-local memo of a right
+// sibling's low key (`instructions/v3.2.0/workorder-dm-leaf-upper-bound.md`
+// §2). Keyed by the sibling's own page id and its owner's oid, so the link
+// read under the leaf's hold picks the entry and is its validation (DM-R4):
+// a page id names one page for its owner's life (no tree page is freed while
+// its owner lives), its low key never moves (invariant 2; an index leaf's
+// first entry is never removed), and an owner oid is never reissued within
+// a run (`Catalog::GenerateUserOid`'s instance sequence). The memo is
+// per thread - a reactor is one thread - and memory only.
+//
+// `DM_MEMO_ENTRIES` in the server's environment sizes each table
+// (direct-mapped by page id); unset reads 1024 (DM-Q7 (a)), 0 turns it off.
+
+#include <cstddef>
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+#include <vector>
+
+namespace kds::storage::dm_memo {
+
+inline constexpr std::size_t kMaxIndexKeyBytes = 48;
+
+inline std::size_t Entries() {
+    static const std::size_t n = [] {
+        const char* v = std::getenv("DM_MEMO_ENTRIES");
+        return v != nullptr ? static_cast<std::size_t>(std::strtoull(v, nullptr, 10))
+                            : std::size_t{1024};
+    }();
+    return n;
+}
+
+struct BtEntry {
+    std::uint64_t owner = 0;
+    std::uint32_t page = 0;
+    std::uint32_t valid = 0;
+    std::uint64_t low = 0;
+};
+
+struct IxEntry {
+    std::uint64_t owner = 0;
+    std::uint32_t page = 0;
+    std::uint16_t width = 0;
+    std::uint16_t valid = 0;
+    std::byte low[kMaxIndexKeyBytes];
+};
+
+inline BtEntry* BtSlot(std::uint32_t page) {
+    thread_local std::vector<BtEntry> table;
+    const std::size_t n = Entries();
+    if (n == 0) return nullptr;
+    if (table.size() != n) table.assign(n, BtEntry{});
+    return &table[page % n];
+}
+
+inline IxEntry* IxSlot(std::uint32_t page) {
+    thread_local std::vector<IxEntry> table;
+    const std::size_t n = Entries();
+    if (n == 0) return nullptr;
+    if (table.size() != n) table.assign(n, IxEntry{});
+    return &table[page % n];
+}
+
+}  // namespace kds::storage::dm_memo
