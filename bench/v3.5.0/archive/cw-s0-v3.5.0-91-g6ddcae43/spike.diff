diff --git a/include/kds/base/cw_probe.hpp b/include/kds/base/cw_probe.hpp
new file mode 100644
index 00000000..c083c71c
--- /dev/null
+++ b/include/kds/base/cw_probe.hpp
@@ -0,0 +1,45 @@
+#pragma once
+
+// CW-S0's spike instrument (`instructions/v3.2.0/workorder-cw-optimistic-page-read.md`
+// CW-S0). Never landed: it lives on the unpushed spike branch only.
+//
+// Two switches, read once from the environment at static init, each a
+// predictable branch when off:
+//   KDS_CW_COUNT=1  count fetches by kind, frame-table holds and every
+//                   compare-and-swap attempt on a page-latch word (M1);
+//   KDS_CW_TICKS=1  bracket every fetch and every release with two `rdtsc`
+//                   reads and sum the ticks per core (M3's substitute: this
+//                   host has no PMU and no profiler).
+// With both off the binary differs from the tree only by the branches and by
+// a release build reading `KDS_TEST_PAGE_LATCH` (M5's armed one-core store).
+
+#include <cstdint>
+#include <cstdlib>
+#include <x86intrin.h>
+
+#include "kds/base/contention.hpp"
+
+namespace kds::cw {
+
+inline bool EnvOn(const char* name) noexcept {
+    const char* e = std::getenv(name);
+    return e != nullptr && e[0] == '1';
+}
+
+inline const bool kCount = EnvOn("KDS_CW_COUNT");
+inline const bool kTicks = EnvOn("KDS_CW_TICKS");
+
+inline std::uint64_t Start() noexcept { return kTicks ? __rdtsc() : 0; }
+
+inline void Stop(Tally calls, Tally ticks, std::uint64_t t0) noexcept {
+    if (!kTicks) return;
+    const std::uint64_t t1 = __rdtsc();
+    Contention::Add(calls);
+    Contention::Add(ticks, t1 - t0);
+}
+
+inline void Count(Tally t, std::uint64_t n = 1) noexcept {
+    if (kCount) Contention::Add(t, n);
+}
+
+}  // namespace kds::cw
