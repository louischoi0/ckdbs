+// ---- DG-S0 measurement spike: never landed --------------------------------
+// `KDS_DG_SPIKE`, a comma list: `nofill` (P1: no zero fill where
+// posix_fallocate reserved; the fsync kept), `pool=N` (M2: N bodies built,
+// filled and synced at Open, before any window, each later body taken from
+// them by a rename), `cold` (M2: the pool's pages dropped from the page
+// cache), `pace=US` (M3/P2: a body built ahead is filled 1 MiB at a time,
+// each piece written back by sync_file_range and followed by a US-microsecond
+// sleep). `KDS_DG_FILL_LOG` names a file each body's timings are appended to
+// (M4), on every arm; its stamps are CLOCK_MONOTONIC ns, the driver's clock.
+struct DgSpike {
+    bool nofill = false;
+    bool cold = false;
+    int pool = 0;
+    long pace_us = 0;
+    int log_fd = -1;
+};
+const DgSpike& Dg() {
+    static const DgSpike cfg = [] {
+        DgSpike c;
+        if (const char* v = std::getenv("KDS_DG_SPIKE")) {
+            std::string all(v);
+            std::size_t at = 0;
+            while (at <= all.size()) {
+                const std::size_t end = std::min(all.find(',', at), all.size());
+                const std::string tok = all.substr(at, end - at);
+                if (tok == "nofill") c.nofill = true;
+                if (tok == "cold") c.cold = true;
+                if (tok.rfind("pool=", 0) == 0) c.pool = std::atoi(tok.c_str() + 5);
+                if (tok.rfind("pace=", 0) == 0) c.pace_us = std::atol(tok.c_str() + 5);
+                at = end + 1;
+            }
+        }
+        if (const char* f = std::getenv("KDS_DG_FILL_LOG")) {
+            c.log_fd = ::open(f, O_WRONLY | O_CREAT | O_APPEND | O_CLOEXEC, 0644);
+        }
+        return c;
+    }();
+    return cfg;
+}
+std::uint64_t DgMono() {
+    return static_cast<std::uint64_t>(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                                          std::chrono::steady_clock::now().time_since_epoch())
+                                          .count());
+}
+void DgLine(const std::string& line) {
+    if (Dg().log_fd < 0) return;
+    const std::string l = line + "\n";
+    (void)!::write(Dg().log_fd, l.data(), l.size());
+}
