+// M2: a body taken from the pool Open built, renamed to `temp`; nothing
+// when the pool is spent.
+std::optional<FileDescriptor> FileLogDevice::DgTakePooled(const std::string& temp) {
+    if (dg_pool_.empty()) return std::nullopt;
+    const std::string from = dg_pool_.back();
+    dg_pool_.pop_back();
+    const std::uint64_t t0 = DgMono();
+    if (::rename(from.c_str(), temp.c_str()) != 0) return std::nullopt;
+    auto fd = OpenSegmentFile(temp, /*create_exclusive=*/false);
+    if (!fd.ok()) return std::nullopt;
+    DgLine("pooled seg_temp=" + std::filesystem::path(temp).filename().string() +
+           " start_ns=" + std::to_string(t0) + " end_ns=" + std::to_string(DgMono()) +
+           " left=" + std::to_string(dg_pool_.size()));
+    return std::move(fd.value());
+}
+
+void FileLogDevice::DgBuildPool() {
+    for (int i = 0; i < Dg().pool; ++i) {
+        const std::string path = dir_ + "/dg-pool-" + std::to_string(i);
+        (void)::unlink(path.c_str());
+        auto fd = OpenSegmentFile(path, /*create_exclusive=*/true);
+        if (!fd.ok()) break;
+        bool fallocated = false;
+        std::uint64_t w = 0;
+        std::uint64_t y = 0;
+        if (!Reserve(fd.value().get(), segment_size_, path, &fallocated).ok()) break;
+        if (!Prewrite(fd.value().get(), segment_size_, false, 0, &w, &y).ok()) break;
+        if (Dg().cold) {
+            (void)::posix_fadvise(fd.value().get(), 0, 0, POSIX_FADV_DONTNEED);
+        }
+        dg_pool_.push_back(path);
+    }
+    DgLine("pool built=" + std::to_string(dg_pool_.size()) + " cold=" +
+           std::to_string(Dg().cold ? 1 : 0) + " at_ns=" + std::to_string(DgMono()));
+}
