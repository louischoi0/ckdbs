+// ---- EM's C1 and C3: the one parse, and the arguments it collects ----------
+//
+// **C1** (EM-R1, EM-R3): an unnamed statement's one parse at `C_PARSE`,
+// `KeptParse::OfText` of its trimmed text, is the dispatcher's own parse of
+// that text - `Parser(text).Parse()` - for every statement of the corpus and
+// `kExtra`, with leading and trailing white space and without: the same AST
+// (`Dump`), every fingerprint field, and for a text whose parse fails the
+// same refusal in the same words (so the same byte), the same lock-clause
+// fact and the same fingerprint. Its `pattern_id` is `FingerprintOf`'s.
+//
+// **C3**: a parse asked to collect gives `ArgumentsOf` of its text, kind for
+// kind and byte for byte, whenever it succeeds.
+
+bool SameFingerprint(const Fingerprint& a, const Fingerprint& b) {
+    return a.pattern_id == b.pattern_id && a.fetch_id == b.fetch_id && a.arg_hash == b.arg_hash &&
+           a.literal_count == b.literal_count && a.param_count == b.param_count;
+}
+
+bool SameArguments(const std::vector<StatementArgument>& a,
+                   const std::vector<StatementArgument>& b) {
+    if (a.size() != b.size()) return false;
+    for (std::size_t i = 0; i < a.size(); ++i) {
+        if (a[i].kind != b[i].kind || a[i].text != b[i].text) return false;
+    }
+    return true;
+}
+
+// The corpus, `kExtra`, and texts the native grammar declines: the query
+// layer's forms, refused locking clauses and truncated statements.
+std::vector<std::string> OneParseCorpus() {
+    std::vector<std::string> out = CorpusStatements();
+    for (const char* extra : kExtra) out.emplace_back(extra);
+    for (const char* declined :
+         {"SELECT v * 2 FROM t WHERE id = 1", "SELECT DISTINCT v FROM t WHERE id = 1",
+          "SELECT a.v FROM a LEFT JOIN b ON a.id = b.id", "SELECT * FROM t WHERE id = 1 FOR SHARE",
+          "SELECT * FROM t WHERE id = 1 FOR UPDATE NOWAIT", "SELECT * FROM",
+          "SELECT * FROM t WHERE v = 'abc", "UPDATE t SET", "DELETE t WHERE id = 1",
+          "INSERT INTO t VALUES (1", "SELECT 1 UNION SELECT 2", "SELECT * FROM t WHERE id = $x"}) {
+        out.emplace_back(declined);
+    }
+    return out;
+}
+
+TEST(KeptParseTest, AnUnnamedStatementsOneParseIsTheDispatchersParseOfItsText) {
+    std::size_t kept = 0;
+    std::size_t declined = 0;
+    for (const std::string& base : OneParseCorpus()) {
+        if (base.find('?') != std::string::npos) continue;  // C1 keeps no `?` text
+        for (const std::string& sql : {base, "  " + base + " \n", "\t" + base}) {
+            const std::string_view text = TrimmedText(sql);
+            DeclinedParse failed;
+            auto one = KeptParse::OfText(text, &failed);
+            Parser dispatcher(text);
+            auto parsed = dispatcher.Parse();
+            if (!parsed.ok()) {
+                ++declined;
+                EXPECT_FALSE(one.has_value()) << sql;
+                EXPECT_EQ(failed.text, text) << sql;
+                EXPECT_EQ(failed.status.code(), parsed.status().code()) << sql;
+                EXPECT_EQ(failed.status.message(), parsed.status().message()) << sql;
+                EXPECT_EQ(failed.met_lock_clause, dispatcher.met_lock_clause()) << sql;
+                const auto fp = dispatcher.fingerprint();
+                ASSERT_EQ(failed.fingerprint.has_value(), fp.has_value()) << sql;
+                if (fp.has_value()) EXPECT_TRUE(SameFingerprint(*failed.fingerprint, *fp)) << sql;
+                continue;
+            }
+            EXPECT_TRUE(failed.text.empty()) << sql;
+            const Statement& stmt = parsed.value();
+            const bool dml = std::holds_alternative<SelectStmt>(stmt) ||
+                             std::holds_alternative<InsertStmt>(stmt) ||
+                             std::holds_alternative<UpdateStmt>(stmt) ||
+                             std::holds_alternative<DeleteStmt>(stmt);
+            ASSERT_EQ(one.has_value(), dml) << sql;
+            if (!dml) continue;
+            ++kept;
+            const auto fp = dispatcher.fingerprint();
+            const auto standalone = FingerprintOf(sql);
+            ASSERT_TRUE(fp.has_value() && standalone.has_value()) << sql;
+            EXPECT_TRUE(SameFingerprint(one->fingerprint(), *fp)) << sql;
+            EXPECT_EQ(one->fingerprint().pattern_id, standalone->pattern_id) << "EM-Q4: " << sql;
+            EXPECT_EQ(one->exact_text(), text) << sql;
+            auto bound = Bind(std::make_shared<const KeptParse>(std::move(*one)), {}, sql);
+            ASSERT_TRUE(bound.ok()) << sql << ": " << bound.status().message();
+            EXPECT_EQ(Dump(bound.value()->Materialize()), Dump(stmt)) << sql;
+            EXPECT_TRUE(SameFingerprint(bound.value()->fingerprint, *fp)) << sql;
+            EXPECT_TRUE(SameArguments(bound.value()->arguments, ArgumentsOf(text))) << sql;
+            // A second copy is the parse's too: one text is consumed more
+            // than once (EM-R3).
+            EXPECT_EQ(Dump(bound.value()->Materialize()), Dump(stmt)) << sql;
+        }
+    }
+    EXPECT_GT(kept, 300u);
+    EXPECT_GT(declined, 30u);
+}
+
+TEST(KeptParseTest, ACollectingParseGivesArgumentsOfItsText) {
+    std::size_t compared = 0;
+    for (const std::string& sql : OneParseCorpus()) {
+        Parser parser(sql);
+        parser.CollectArguments();
+        if (!parser.Parse().ok()) continue;
+        ASSERT_NE(parser.arguments(), nullptr);
+        EXPECT_TRUE(SameArguments(*parser.arguments(), ArgumentsOf(sql))) << sql;
+        ++compared;
+    }
+    EXPECT_GT(compared, 200u);  // a `?` text parses only with holes admitted
+    Parser unasked("SELECT * FROM t WHERE id = 1");
+    ASSERT_TRUE(unasked.Parse().ok());
+    EXPECT_EQ(unasked.arguments(), nullptr);
+}
