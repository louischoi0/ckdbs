new file mode 100644
index 00000000..93672cd8
--- /dev/null
+++ b/include/kds/base/cz_spike.hpp
@@ -0,0 +1,122 @@
+#pragma once
+
+// **CZ-S1's spike** (`instructions/v3.2.0/workorder-cz-checkpoint-roll-wait.md`
+// §5): measurement only, never landed, and it carries no proof. One binary
+// runs every arm, chosen by the environment:
+//
+//   KDS_CZ_SPIKE=c1      the cadence checkpoint's stream-latch sites try the
+//                        latch and park when it is busy (C1a, C1b, C1c)
+//   KDS_CZ_SPIKE=c2      no zero prewrite where `posix_fallocate` reserved
+//   KDS_CZ_SPIKE=c1,c2   both
+//
+// Unset, the engine behaves as it did, and the sites are only timed.
+
+#include <array>
+#include <chrono>
+#include <cstddef>
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+
+namespace kds::cz {
+
+inline unsigned Mode() noexcept {
+    static const unsigned mode = [] {
+        const char* v = std::getenv("KDS_CZ_SPIKE");
+        unsigned m = 0;
+        if (v != nullptr && std::strstr(v, "c1") != nullptr) m |= 1U;
+        if (v != nullptr && std::strstr(v, "c2") != nullptr) m |= 2U;
+        return m;
+    }();
+    return mode;
+}
+inline bool C1() noexcept { return (Mode() & 1U) != 0; }
+inline bool C2() noexcept { return (Mode() & 2U) != 0; }
+
+// This thread's next acquisitions of the stream latch are tries.
+inline thread_local bool tl_try = false;
+// A try found the latch held, or another thread's flush in flight.
+inline thread_local bool tl_busy = false;
+// The stream-latch wait this thread has paid, summed: a site reads it before
+// and after its call.
+inline thread_local std::uint64_t tl_latch_wait_ns = 0;
+// The publish's writeback is running on this thread: its inline gate is
+// counted apart from a step's.
+inline thread_local bool tl_in_publish = false;
+
+enum class Site : std::size_t {
+    kBegin,        // CHECKPOINT_BEGIN's append
+    kAssert,       // the assertion bases' appends, inside `Start`
+    kFlush,        // the log park's flush (`RequestSyncNow`)
+    kEnd,          // CHECKPOINT_END's append
+    kRecycle,      // the anchor's commit, which recycles when the redo start moved
+    kGateStep,     // the inline WAL gate, taken by a step
+    kGatePublish,  // the inline WAL gate, taken by the publish's writeback
+    kCount,
+};
+inline constexpr std::size_t kSiteCount = static_cast<std::size_t>(Site::kCount);
+inline constexpr std::array<const char*, kSiteCount> kSiteNames{
+    "begin", "assert", "flush", "end", "recycle", "gate_step", "gate_publish"};
+
+struct SiteStats {
+    std::uint64_t calls = 0;         // calls made, tries included
+    std::uint64_t busy = 0;          // tries answered busy
+    std::uint64_t parks = 0;         // of those, parked on a roll; the rest yielded once
+    std::uint64_t bound = 0;         // times the park bound was reached and the blocking call made
+    std::uint64_t call_ns = 0;       // reactor time inside the calls
+    std::uint64_t call_max_ns = 0;
+    std::uint64_t latch_ns = 0;      // of that, waiting for the stream latch
+    std::uint64_t latch_max_ns = 0;
+    std::uint64_t park_ns = 0;       // wall time parked for a busy latch; the reactor ran other work
+};
+
+struct Report {
+    std::array<SiteStats, kSiteCount> site{};
+    SiteStats& at(Site s) noexcept { return site[static_cast<std::size_t>(s)]; }
+};
+
+inline std::uint64_t NowNs() noexcept {
+    return static_cast<std::uint64_t>(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                                          std::chrono::steady_clock::now().time_since_epoch())
+                                          .count());
+}
+
+// One call at a site: timed, its latch wait read off the thread's counter,
+// and the stream latch a try for its length when `try_latch`. The caller
+// reads `tl_busy` before the scope ends.
+class SiteCall {
+public:
+    SiteCall(Report* report, Site site, bool try_latch) noexcept
+        : report_(report),
+          site_(site),
+          saved_try_(tl_try),
+          start_(NowNs()),
+          latch_before_(tl_latch_wait_ns) {
+        tl_try = try_latch;
+        tl_busy = false;
+    }
+    ~SiteCall() {
+        tl_try = saved_try_;
+        if (report_ == nullptr) return;
+        SiteStats& s = report_->at(site_);
+        const std::uint64_t ns = NowNs() - start_;
+        const std::uint64_t latch = tl_latch_wait_ns - latch_before_;
+        ++s.calls;
+        if (tl_busy) ++s.busy;
+        s.call_ns += ns;
+        if (ns > s.call_max_ns) s.call_max_ns = ns;
+        s.latch_ns += latch;
+        if (latch > s.latch_max_ns) s.latch_max_ns = latch;
+    }
+    SiteCall(const SiteCall&) = delete;
+    SiteCall& operator=(const SiteCall&) = delete;
+
+private:
+    Report* report_;
+    Site site_;
+    bool saved_try_;
+    std::uint64_t start_;
+    std::uint64_t latch_before_;
+};
+
+}  // namespace kds::cz
