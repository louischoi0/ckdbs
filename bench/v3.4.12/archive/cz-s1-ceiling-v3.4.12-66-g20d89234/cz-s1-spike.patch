+sched::Coro Checkpointer::ParkForLatch(cz::Site site) {
+    // CZ-S1 spike: parked while a roll holds the stream latch; any shorter
+    // holder (an append, another thread's flush in flight) costs the one
+    // yield, and its caller does not count that try against the bound - a
+    // yield on an idle reactor returns at once, so sixteen of them are spent
+    // in microseconds. No wake is asked for: the predicate is read at this
+    // reactor's next turn, at most one idle block later.
+    const std::function<bool()> clear = [this] {
+        return !wal_.stream()->rolling() || wal_.stopped();
+    };
+    const std::uint64_t parked = cz::NowNs();
+    if (!clear()) {
+        ++task_report_.cz.at(site).parks;
+        sched::WaitScope wait(stats::WaitEvent::kSysioWalWrite);
+        co_await sched::WaitUntil{&clear};
+    }
+    co_await sched::Yield{};
+    task_report_.cz.at(site).park_ns += cz::NowNs() - parked;
+    co_return Status::OK();
+}
