# KDS server configuration — sample
#
# Copy to kds.conf (or anywhere) and pass with:  kds_server --config <path>
#
# Format is `key = value`, one per line. `#` starts a comment. Quote a value
# to keep surrounding whitespace or a literal '#'.
#
# Precedence: built-in defaults, then this file, then command-line flags.
# A later source wins, so a flag can override a deployed file for one run.
#
# Every key below is optional — an omitted key keeps its default. An
# *unknown* key is a startup error rather than a warning: a typo like
# `chekpoint_interval_ms` would otherwise look like it worked, and the
# operator would find out when the loss window turned out to be the default.

# ---- Storage ---------------------------------------------------------------

# Path to the data file. Created if absent.
data_file = kds.db

# Directory holding the per-core WAL segment files (docs/wal.md §4.1).
# Defaults to "<data_file>.wal" when unset.
# wal_dir = kds.db.wal

# How many bytes every variable-width value (a `varchar`) occupies inside a
# tuple (docs/heap-and-tuple.md §3.3). Every tuple is fixed-length: a
# relation's row size is a schema constant, and a varchar gets exactly this
# many bytes whatever it holds — which is what makes an UPDATE unable to
# move a row.
#
# This key is read exactly once, when a *new* database is bootstrapped, and
# the value is pinned into the superblock. Every later mount compares this
# setting against the pinned one and refuses to start if they differ,
# naming both: on-disk tuple layout is computed from the width, so running
# with a different one would not fail, it would decode every row at the
# wrong offsets. Changing it for an existing database is a rebuild, and
# there is no migration path.
#
# The usable inline capacity is width − 3 (a tag byte and a u16 length); a
# longer value belongs in the var-heap, which is specified but not yet
# implemented, so it is refused today. Legal range 16..4096.
#
# 64 is [PROPOSED], not settled — sized so common OLTP strings (codes,
# names, references) never spill, and to be measured against the real
# string-length distributions of target schemas. The counter-cost is 64
# bytes per string column per row, paid whether or not the value is short.
inline_cell_width = 64

# How many reactor cores this instance runs (docs/workplan-crosscore.md M6).
#
# Pinned into the superblock when the database is created and validated
# against it on every mount after — a mismatch refuses to start, naming both
# numbers. WAL streams are per core, so this decides how many streams the
# database has, and mounting under a different count would leave the
# difference with nothing to replay them.
#
# A value above 1 spawns that many pinned reactor threads, each with its own
# WAL stream (workplan P0-P2). **Core 0 still serves every statement**: a
# peer cannot read the catalog until the per-core catalog cache exists
# (workplan P6), so the other cores come up alive and idle. Raising this
# today buys parallel WAL streams and nothing else - and costs a thread and
# a ring matrix - so 1 remains the right setting until P4.
#
# Bounded above by the superblock's 64 WAL anchor slots, and refused if it
# exceeds the machine's reported core count: reactors are pinned and never
# block, so overcommitting them serializes whole workloads behind each other.
cores = 1

# ---- Network ---------------------------------------------------------------

# TCP port, loopback only. 1..65535.
port = 15432

# ---- Durability ------------------------------------------------------------

# How often the system-group checkpoint task flushes dirty pages
# (docs/wal.md §11). This is the loss-window knob: lower means less data at
# risk on a crash and more I/O. 0 disables the cadence entirely, which puts
# durability back on SYNC and clean shutdown alone.
#
# Checkpoint cadence is an [OPEN] decision in docs/wal.md §13 — this default
# is a starting point, not a recommendation.
checkpoint_interval_ms = 5000

# Durability class applied to every logged statement (docs/wal.md §1).
# Today that means INSERT and nothing else — CREATE TABLE, UPDATE and the
# catalog rows under both still write pages outside the log, so no setting
# here makes them crash-safe.
#
#   strict  (d1)  the INSERT reply is sent only after its commit record is
#                 fsync'd. One fsync per insert.
#   group   (d2)  same durability point, one fsync amortized over a batch
#                 of concurrent committers. Identical in cost to `strict`
#                 until the server serves more than one connection at a
#                 time, since a batch of one is a batch.
#   relaxed (d3)  the reply is sent immediately; commits become durable on
#                 the drain below. Trades a bounded loss window for not
#                 waiting on the device — measured here as ~8x the insert
#                 throughput of strict on an EBS gp3 volume.
#
# Per-transaction in the design; per-server here only because the newline
# protocol has nowhere to carry it. KWP/1 makes it a protocol field.
durability = group

# How often the system-group WAL drain runs, in microseconds. It bounds a
# `relaxed` commit's loss window and resolves a `group` batch nobody is
# waiting on. A tick with nothing staged does no I/O, so this is cheap to
# run often. 0 disables it, which leaves relaxed commits unsynced until the
# next checkpoint or shutdown.
wal_drain_interval_us = 1000

# How long a `relaxed` commit may sit unsynced - D3's loss window
# (docs/wal.md). It is also a **latency** dial, which is less obvious: the
# sync that enforces it runs on the reactor thread, so the statement in
# flight when it fires pays the device's full latency. Measured on an EBS
# volume, the default produces one ~2.2 ms statement every 12 ms and is the
# whole of a relaxed instance's tail (bench/results-latency-matrix.md).
# Raising it thins the stalls out and lengthens the window of committed work
# a crash can lose; it cannot remove them.
relaxed_flush_interval_us = 10000

# ---- Query limits ----------------------------------------------------------

# Ceiling on the tuples a single statement may decode before it is refused
# with `ResourceExhausted`. 0 means unlimited.
#
# This is not a performance knob, it is a availability one. Nothing
# suspends mid-statement: the engine is thread-per-core and cooperative
# (docs/rules.md §3), so a statement runs to completion on the core it
# started on and every other client on that core waits for it. A statement
# that reads an unbounded number of rows therefore does not run slowly, it
# takes a core out of service.
#
# The easy way to write one is a correlated subquery or a join on a non-pk
# column: both read the inner relation once per outer row, so two relations
# of n rows is n² decodes from a statement that fits on one line and looks
# entirely reasonable. Failing after a bounded amount of work is the kinder
# answer than a connection that never replies - the client can rewrite the
# statement, where it cannot diagnose a hang.
#
# The default is `[PROPOSED]`, set where it can only catch accidents: a
# full scan of a relation filling a 64 MB buffer pool is on the order of
# 10⁶ tuples, so 10⁸ leaves two orders of magnitude of headroom above
# anything deliberate. The right number comes from measuring the workloads
# this engine is actually pointed at.
#
# Set it to 0 for one honest purpose: measuring the cost of the very
# statement the budget would refuse.
max_rows_touched = 100000000

# ---- Waystone --------------------------------------------------------------

# Whether a successful SELECT records where it found its rows, so a repeated
# query pattern can later look instead of search (docs/waystone-concpets.md).
#
# What it costs: one waystone page per pattern *instance* that executes twice
# (once, for a pattern declared with CREATE PATTERN - a declaration is the
# evidence the second execution would otherwise supply). Trails are unlogged,
# so a crash loses whatever the last checkpoint did not carry, which costs
# future replays and never results.
#
# What it buys: whatever `waystone_replay` below can then use. With replay
# off this is pure write side and buys nothing, which is a reasonable way to
# measure the recording cost on its own.
#
# Turning it on and off must never change a single reply. That equality is a
# regression test, and it is also something you can check against your own
# data.
waystone_recording = on

# Whether a SELECT may be served from a trail a previous execution recorded:
# a validated location read directly, instead of a B+ tree descent or a heap
# chain scan.
#
# This is the half that repays recording, and the only Waystone setting that
# can be asked to produce a row. It still cannot change one: a trail supplies
# a *location*, which is then read and filtered by exactly the code a
# descent's location would have been, and every entry is validated against
# the tuple actually there before anything is read from it. Deleting every
# trail in the database changes latency and nothing else - that is invariant
# 8, and tests/waystone_contract_test.cpp compares five configurations byte
# for byte to keep it true.
waystone_replay = on

# ---- Access statistics -----------------------------------------------------

# Whether a successful SELECT records what each of its steps actually did:
# one row per access *shape* in `sys.access_stats`, readable with
# `SHOW ACCESS` (docs/heap-and-tuple.md section 7).
#
# A shape is `(kind, relation, columns)` - `Lookup`, `Probe`, `Range`,
# `FilterScan` or `Scan`, the relation, and the columns the access was keyed
# or filtered on. **Never the values**: `WHERE flag = 1` and `WHERE flag = 2`
# are one shape with two uses. That is what bounds the relation by the schema
# instead of by the data, so it needs no eviction and no cap beyond a
# backstop.
#
# What it is for: the physical optimizer that section 7 describes and that
# does not exist yet. "This relation was filter-scanned on `flag` 40,000
# times" is the signal that would justify clustering or indexing it. Nothing
# consumes this yet - it is being collected now so the history exists when
# something does.
#
# Measured cost: +1-2% on a point lookup, unmeasurable on anything slower.
# Independent of the Waystone switches above.
access_statistics = on

# ---- Cabins ----------------------------------------------------------------

# Whether Cabins may be built and served (docs/feat-cabin.md).
#
# A Cabin is a per-(relation, non-pk column) store that is **authoritative
# for the values queries have actually observed** - the third trust class,
# between the clustered pk tree (always authoritative) and a Waystone trail
# (never authoritative). For an observed value it holds a superset of the
# matching rows' primary keys, so `WHERE sym = 'AAPL'` reads those rows
# instead of the relation, and an observed value with *no* matching rows
# answers zero rows without opening the relation at all - which no advisory
# structure can do.
#
# What it costs: one in-memory directory probe per cabined column per write
# to that relation. That is the price of authority - absence needs a witness
# - and it is why a Cabin is per column and opt-in rather than automatic.
# A relation with no Cabin pays one integer test.
#
# On by default because it does **nothing** until a `CREATE CABIN ON t(col)`
# or a `CABIN` clause on a column at `CREATE TABLE`. Off is what the contract
# tests compare against: replies must be byte-identical either way, one value
# at a time, because un-observing a value is always legal.
#
# The sets live in memory only and do not survive a restart - by design, not
# omission: the completeness promise holds only while the write hook is live,
# so a crash declares every Cabin unobserved and traffic rebuilds it.
cabins = on

# ---- Secondary indexes (docs/feat-index.md) --------------------------------
#
# Whether a secondary index may be **read**. Off makes an index step take the
# walk it would have taken had the index not existed.
#
# **A read-path switch only, and the asymmetry is deliberate.** There is no
# key for index *maintenance*, because an index that stops being maintained
# is wrong rather than slow - a config key that can produce a wrong answer is
# not a config key. Turning the write cost off is a catalog act: `DROP INDEX`.
#
# On by default because it does nothing until a `CREATE INDEX`. Off is what
# the contract tests compare against: replies must be byte-identical either
# way, and the *compiled chain* is identical too - `indexes = off` steers the
# branch inside an index step, never which step was compiled - so the
# comparison is over execution rather than over planning.
indexes = on

# How much one Cabin may hold: distinct observed values, and entries per
# value. `[PROPOSED]` - docs/feat-cabin.md section 8 leaves the budget open,
# so these are configurable rather than compiled in, and nothing depends on
# the numbers.
#
# What does depend on them is the rule they enforce: a cap **refuses to
# observe** a value, and never truncates its entry set. A truncated set
# marked authoritative would be missing rows a query is entitled to - a wrong
# answer rather than a smaller one. So exceeding either limit returns that
# value to the ordinary scan path, which is always legal.
#
# `cabin_max_values = 0` observes nothing, which switches the behaviour off
# while keeping the catalog objects.
cabin_max_values = 4096
cabin_max_entries_per_value = 4096

# ---- Aggregation -----------------------------------------------------------

# How much one aggregated statement may hold: groups, and DISTINCT entries
# summed over every set in the statement. `[PROPOSED]` - docs/feat-aggregate.md
# section 6 leaves the numbers open until the first bench, so they are
# configurable rather than compiled in and nothing depends on either value.
#
# What does depend on them is the rule they enforce, and it is a *different*
# rule from the Cabin caps above. A Cabin that hits its cap stops observing
# and falls back to a scan, which is always legal because a Cabin is only
# ever a shortcut. An aggregation has no shortcut to fall back to: a group
# set that stopped growing is missing groups, and a distinct set that stopped
# growing counts too few. Both are wrong answers with a right answer's shape,
# and no reader can detect either. So these caps **fail the statement**,
# naming the key, and emit nothing at all - there is no spill, no truncation
# and no partial answer.
#
# `aggregate_max_groups = 0` founds no group, which refuses every aggregated
# statement while leaving the grammar in place.
aggregate_max_groups = 65536
aggregate_max_distinct = 1048576

# ---- Logging ---------------------------------------------------------------

# Diagnostic log destination. `log_dir` is prepended to `log_file` unless
# `log_file` is already absolute. Missing directories are created.
# Set log_file empty to disable file logging entirely.
log_dir  =
log_file = kdb.log

# trace | debug | info | warn | error | off
#
# `debug` includes a line per checkpoint, which is the cheapest way to see
# whether the cadence is actually running.
log_level = info

# The isolation level a session starts at, and therefore the level an
# autocommit statement runs at (docs/txn.md section 1).
#
#   read committed    (default) a read view per statement
#   repeatable read             a read view per transaction
#
# READ COMMITTED is the default for a reason specific to this engine rather
# than convention: under first-updater-wins with no waiting, REPEATABLE READ
# holds one read view for a whole transaction and so turns more concurrent
# writes into retryable aborts. SERIALIZABLE is out of scope, not unset.
#
# This is the server rung of a three-level chain - a session may override it
# with `SET ISOLATION LEVEL`, and one transaction with
# `BEGIN ISOLATION LEVEL`.
# isolation = read committed
